# Copy to .env.deploy at the project root (never commit the real file).
# Use independent random hex values: python3 -c 'import secrets; print(secrets.token_hex(32))'
# Hex avoids URL escaping issues in the PostgreSQL connection string.
POSTGRES_PASSWORD=
AUTH_SESSION_SECRET=
APP_ENV=production
REQUIRE_AUTH=true
# Local HTTP container test: false. Public HTTPS hosting: MUST be true.
AUTH_COOKIE_SECURE=false
BACKEND_CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
WEB_BIND=127.0.0.1
WEB_PORT=8080
# Hosting only: a domain whose DNS points at your VM (no https:// prefix).
HTTPS_DOMAIN=
# Extra private-preview gate before app login. Caddy requires a password HASH.
PREVIEW_USER=owner
# Put a bcrypt hash in single quotes to preserve its dollar signs.
PREVIEW_PASSWORD_HASH=
REPORT_TIMEZONE=Australia/Melbourne
MARKET_DATA_PROVIDER=alpaca
MARKET_DATA_API_KEY=
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_DATA_FEED=iex
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GOOGLE_CLIENT_ID=
