# Application
APP_ENV=development
LOG_LEVEL=info

# Backend
BACKEND_HOST=localhost
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=http://localhost:5173

# Frontend
VITE_API_BASE_URL=http://localhost:8000

# Database
# Replace with a real local or managed PostgreSQL URL when the database is introduced.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/stock_intelligence

# Market Data
# Provider and key will be selected in a later phase.
MARKET_DATA_PROVIDER=
MARKET_DATA_API_KEY=

# AI Provider
# Add only when the AI assistant phase begins.
OPENAI_API_KEY=
