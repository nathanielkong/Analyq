# Application
APP_ENV=development
LOG_LEVEL=info

# Backend
BACKEND_HOST=localhost
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=http://localhost:5173

# Frontend
VITE_API_BASE_URL=http://localhost:8000

# Database
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/stock_intelligence

# Market Data
# Keep this key in your local backend/.env file. Never commit the real value.
MARKET_DATA_PROVIDER=alpaca
MARKET_DATA_API_KEY=
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_DATA_FEED=iex

# AI Provider
# Keep real keys only in backend/.env.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# Daily stock reports expire at midnight in this timezone.
REPORT_TIMEZONE=Australia/Melbourne
OPENAI_API_KEY=

# Authentication
# Create a Web OAuth client in Google Cloud and authorize http://localhost:5173.
GOOGLE_CLIENT_ID=
AUTH_SESSION_SECRET=replace-with-a-long-random-value
AUTH_COOKIE_SECURE=false
